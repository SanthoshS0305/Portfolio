# Sanity CMS configuration
# Get these from https://sanity.io after creating a project
REACT_APP_SANITY_PROJECT_ID=your_project_id_here
REACT_APP_SANITY_DATASET=production

# Sanity API token with Editor permissions (from Manage → API → Tokens)
REACT_APP_SANITY_TOKEN=your_token_here

# Admin panel credentials
REACT_APP_ADMIN_USERNAME=admin
# Generate the SHA-256 hash of your password, e.g. using:
#   node -e "const {createHash}=require('crypto');console.log(createHash('sha256').update('yourpassword').digest('hex'))"
REACT_APP_ADMIN_PASSWORD_HASH=your_sha256_password_hash_here
